# Configurações de conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=memorial_ai_db
DB_USER=admin
DB_PASSWORD=sua_senha

# Endereço do servidor Ollama utilizado pelo protótipo
OLLAMA_URL=http://localhost:11434

# Modelos utilizados na geração de respostas e embeddings
MODEL=llama3
EMBED_MODEL=nomic-embed-text