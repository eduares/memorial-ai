# Execução local (fora do Docker)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=memorial_ai_db
DB_USER=admin
DB_PASSWORD=admin123

# Ollama
OLLAMA_HOST=http://localhost:11434

MODEL=llama3
EMBED_MODEL=nomic-embed-text

# Observação: ao rodar via docker-compose, essas variáveis já são
# injetadas no serviço "app" (DB_HOST=postgres, OLLAMA_HOST=http://ollama:11434),
# não sendo necessário criar um arquivo .env.